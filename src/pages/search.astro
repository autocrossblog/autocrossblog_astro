---
import Layout from "~/layouts/PageLayout.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";


const metadata = {
  title: 'Autocross Blog Search',
};
---
<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl" data-pagefind-ignore="all">
    <p>Use our search engine below to find content related to your query. We hope you find the site useful, if you have any feedback please sure to reach out!</p>
    <br />
    <hr/>
  
    <br />
    <h1>Search the Blog</h1>
    <PagefindConfig />
    <div class="site-search">
      <pagefind-input autofocus placeholder="Search"></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>
  </section>
</Layout>